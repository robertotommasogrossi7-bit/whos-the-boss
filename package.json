{
  "name": "whos-the-boss",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "tsc -p apps/mobile/tsconfig.json --noEmit",
    "dev:mobile": "pnpm --filter @whos-the-boss/mobile start",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "gate:db": "node scripts/gate-db.mjs",
    "gate:import": "tsx scripts/gate-import.ts",
    "gate:push": "tsx scripts/gate-push.ts"
  },
  "devDependencies": {
    "supabase": "^2.109.1",
    "tsx": "^4.23.1",
    "turbo": "^2.3.0"
  }
}
